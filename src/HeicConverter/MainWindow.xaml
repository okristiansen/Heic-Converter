<ui:FluentWindow
    x:Class="HeicConverter.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:HeicConverter.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Title="HEIC Converter"
    Width="1120"
    Height="800"
    MinWidth="880"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    AllowDrop="True"
    PreviewDragEnter="OnWindowPreviewDragEnter"
    DragOver="OnWindowDragOver">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="HEIC Converter">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ============================== Main content ============================== -->
        <Grid Grid.Row="1" Margin="24,4,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- ======== Left: the photo queue ======== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom">
                        <ui:TextBlock FontTypography="Title" Text="Photos" />
                        <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding HeaderText}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding BrowseFilesCommand}"
                            Content="Add photos"
                            Icon="{ui:SymbolIcon Add24}" />
                        <ui:Button
                            Margin="0,0,8,0"
                            Command="{Binding BrowseFolderCommand}"
                            Content="Add folder"
                            Icon="{ui:SymbolIcon FolderAdd24}" />
                        <ui:Button
                            Appearance="Transparent"
                            Command="{Binding ClearFinishedCommand}"
                            Icon="{ui:SymbolIcon Broom24}"
                            ToolTip="Remove converted photos from the list" />
                        <ui:Button
                            Appearance="Transparent"
                            Command="{Binding ClearAllCommand}"
                            Icon="{ui:SymbolIcon Delete24}"
                            ToolTip="Clear the whole list" />
                    </StackPanel>
                </Grid>

                <ui:InfoBar
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    IsClosable="True"
                    IsOpen="{Binding IsSummaryOpen, Mode=TwoWay}"
                    Message="{Binding SummaryMessage}"
                    Severity="{Binding SummarySeverity}"
                    Title="{Binding SummaryTitle}" />

                <Border Grid.Row="2" Padding="0" Style="{StaticResource CardBorder}">
                    <Grid>
                        <!-- Empty state: big drop zone -->
                        <Grid x:Name="EmptyState">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFiles}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Rectangle
                                Margin="12"
                                RadiusX="6"
                                RadiusY="6"
                                Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                StrokeDashArray="5 4"
                                StrokeThickness="1.5" />
                            <StackPanel MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border
                                    Width="96"
                                    Height="96"
                                    Margin="0,0,0,20"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="48">
                                    <ui:SymbolIcon FontSize="44" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="ImageMultiple48" />
                                </Border>
                                <ui:TextBlock HorizontalAlignment="Center" FontTypography="Subtitle" Text="Drop HEIC photos here" />
                                <TextBlock
                                    Margin="0,8,0,24"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="Select as many as you like, or drop whole folders. Everything is converted on your PC. Nothing is uploaded."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <ui:Button
                                        Margin="0,0,8,0"
                                        Padding="16,8"
                                        Appearance="Primary"
                                        Command="{Binding BrowseFilesCommand}"
                                        Content="Browse photos"
                                        Icon="{ui:SymbolIcon ImageAdd24}" />
                                    <ui:Button
                                        Padding="16,8"
                                        Command="{Binding BrowseFolderCommand}"
                                        Content="Add folder"
                                        Icon="{ui:SymbolIcon FolderAdd24}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- The queue -->
                        <ui:ListView
                            Margin="4"
                            ItemsSource="{Binding Files}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionMode="Single"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}">
                            <ui:ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                                    <Grid x:Name="Row" Margin="4,7" Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status icon -->
                                        <Grid Width="22" Height="22" HorizontalAlignment="Left">
                                            <ui:SymbolIcon x:Name="QueuedIcon" FontSize="20" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Symbol="Image24" />
                                            <ui:ProgressRing x:Name="BusyRing" Width="20" Height="20" IsIndeterminate="True" Visibility="Collapsed" />
                                            <ui:SymbolIcon x:Name="DoneIcon" Filled="True" FontSize="22" Foreground="{DynamicResource SystemFillColorSuccessBrush}" Symbol="CheckmarkCircle24" Visibility="Collapsed" />
                                            <ui:SymbolIcon x:Name="FailedIcon" Filled="True" FontSize="22" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Symbol="ErrorCircle24" Visibility="Collapsed" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding Details}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock
                                            x:Name="StatusLabel"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding StatusText}" />

                                        <Grid Grid.Column="3" HorizontalAlignment="Right">
                                            <ui:Button
                                                x:Name="RemoveButton"
                                                Padding="7"
                                                Appearance="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon Dismiss16}"
                                                ToolTip="Remove from list"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                                            <ui:Button
                                                x:Name="ShowButton"
                                                Padding="7"
                                                Appearance="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon FolderOpen20}"
                                                ToolTip="Show in folder"
                                                Visibility="Collapsed" />
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Converting">
                                            <Setter TargetName="QueuedIcon" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="BusyRing" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Done">
                                            <Setter TargetName="QueuedIcon" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="DoneIcon" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="ShowButton" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="Row" Property="ToolTip" Value="{Binding OutputPath}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                            <Setter TargetName="QueuedIcon" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="FailedIcon" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            <Setter TargetName="Row" Property="ToolTip" Value="{Binding Error}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======== Right: settings ======== -->
            <ScrollViewer Grid.Column="2" Margin="0,0,-12,0" Padding="0,0,12,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ui:TextBlock Margin="0,0,0,16" FontTypography="Title" Text="Settings" />

                    <!-- Format -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Convert to" />
                    <Border Margin="0,0,0,16" IsEnabled="{Binding IsIdle}" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <RadioButton
                                    Height="36"
                                    Margin="0,0,4,0"
                                    HorizontalAlignment="Stretch"
                                    Content="JPEG"
                                    GroupName="Format"
                                    IsChecked="{Binding IsJpeg}"
                                    Style="{StaticResource {x:Type ToggleButton}}" />
                                <RadioButton
                                    Height="36"
                                    Margin="4,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Content="PNG"
                                    GroupName="Format"
                                    IsChecked="{Binding IsPng}"
                                    Style="{StaticResource {x:Type ToggleButton}}" />
                            </UniformGrid>
                            <TextBlock
                                Margin="2,10,0,0"
                                Style="{StaticResource CaptionText}"
                                Text="Small files that open everywhere."
                                Visibility="{Binding IsJpeg, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock
                                Margin="2,10,0,0"
                                Style="{StaticResource CaptionText}"
                                Text="Lossless, but about 5× larger and slower."
                                Visibility="{Binding IsPng, Converter={StaticResource BoolToVisibility}}" />

                            <!-- JPEG quality -->
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsJpeg, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <TextBlock Text="Quality" />
                                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding JpegQuality}" />
                                </Grid>
                                <Slider
                                    Margin="0,6,0,0"
                                    IsSnapToTickEnabled="True"
                                    Maximum="100"
                                    Minimum="50"
                                    TickFrequency="1"
                                    ToolTip="90 looks identical to the original for almost every photo"
                                    Value="{Binding JpegQuality}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Output folder -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Save to" />
                    <Border Margin="0,0,0,16" IsEnabled="{Binding IsIdle}" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <RadioButton Content="Same folder as the original" GroupName="Output" IsChecked="{Binding SaveNextToOriginal}" />
                            <RadioButton Margin="0,4,0,0" Content="A folder I choose" GroupName="Output" IsChecked="{Binding UseCustomFolder}" />
                            <Grid Margin="0,10,0,0" IsEnabled="{Binding UseCustomFolder}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Padding="10,7"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="4"
                                    ToolTip="{Binding CustomFolder}">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding CustomFolderDisplay}"
                                        TextTrimming="CharacterEllipsis" />
                                </Border>
                                <ui:Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Command="{Binding ChooseOutputFolderCommand}"
                                    Icon="{ui:SymbolIcon FolderOpen20}"
                                    ToolTip="Choose folder" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="Options" />
                    <Border IsEnabled="{Binding IsIdle}" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Simultaneous conversions" />
                                <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding MaxParallel}" />
                            </Grid>
                            <Slider
                                Margin="0,6,0,0"
                                IsSnapToTickEnabled="True"
                                Maximum="{Binding MaxParallelLimit}"
                                Minimum="1"
                                TickFrequency="1"
                                ToolTip="{Binding CoreCountText}"
                                Value="{Binding MaxParallel}" />

                            <Separator Margin="0,14" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Keep photo details" />
                                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}" Text="Date taken, camera and location" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding KeepMetadata}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================== Footer: progress + actions ============================== -->
        <Border
            Grid.Row="2"
            Padding="24,16"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,32,0" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" />
                        <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding TimeText}" />
                    </Grid>
                    <ProgressBar Height="4" Margin="0,10,0,0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button
                        Height="40"
                        Margin="0,0,8,0"
                        Command="{Binding OpenOutputFolderCommand}"
                        Content="Open folder"
                        Icon="{ui:SymbolIcon FolderOpen20}"
                        Visibility="{Binding CanOpenOutputFolder, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                        Height="40"
                        MinWidth="200"
                        Appearance="Primary"
                        Command="{Binding StartCommand}"
                        Content="{Binding StartButtonText}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                        Height="40"
                        MinWidth="200"
                        Command="{Binding StopCommand}"
                        Content="Stop"
                        Icon="{ui:SymbolIcon RecordStop24}"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== Drag & drop overlay ============================== -->
        <Grid
            x:Name="DropOverlay"
            Grid.RowSpan="3"
            AllowDrop="True"
            Background="{DynamicResource SmokeFillColorDefaultBrush}"
            DragLeave="OnOverlayDragLeave"
            DragOver="OnOverlayDragOver"
            Drop="OnOverlayDrop"
            Visibility="Collapsed">
            <Border
                Margin="20"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="12"
                IsHitTestVisible="False"
                Opacity="0.92" />
            <Rectangle
                Margin="32"
                IsHitTestVisible="False"
                RadiusX="8"
                RadiusY="8"
                Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}"
                StrokeDashArray="6 4"
                StrokeThickness="2" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <ui:SymbolIcon HorizontalAlignment="Center" FontSize="56" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="ArrowDownload48" />
                <ui:TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" FontTypography="Subtitle" Text="Drop to add photos" />
                <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="HEIC files and folders are added to the queue" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
